# ==============================================================================
# Health Copilot AI — Environment Template (.env.example)
# Copy this file to .env and adjust the values for your environment.
# ==============================================================================

# Server Environment & Network Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Security & Authentication Secrets (Generate a strong secret in production)
SECRET_KEY=your_secure_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (Default: Local SQLite Database)
DATABASE_URL=sqlite:///./health_copilot.db
HEALTH_DB_PATH=./health_copilot.db

# CORS Allowed Origins (Comma-separated for multiple domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:8000

# Frontend Public API URL (Leave blank to use default relative /api proxy)
VITE_API_URL=http://127.0.0.1:8000

# Emergency Medical Triage (India Helplines)
EMERGENCY_NUMBER=112
AMBULANCE_NUMBER=108

# Optional Local AI / Ollama LLM Integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
